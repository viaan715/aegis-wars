# Leave blank in dev — the Vite dev server proxies same-origin /api requests
# to the backend (see vite.config.js), which works on localhost, in Docker,
# and through forwarded Codespaces/remote URLs alike. Only set this to point
# the built app at a specific deployed API origin (e.g. production).
VITE_API_BASE_URL=
# Optional: enables the "Sign in with Google" button. Must match server/.env's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
