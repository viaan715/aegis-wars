# Claude API — document extraction + report narrative. Without this the app
# falls back to mocked extraction/summary text so the flow stays testable.
ANTHROPIC_API_KEY=

# Stripe — checkout for the paywall. Use test-mode keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL used for Stripe redirect URLs and sitemap/robots generation.
NEXT_PUBLIC_APP_URL=http://localhost:3000
