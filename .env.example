# Copy to .env and fill in what you need. Every field has a sane default
# (see app/config.py) — only set what you're actually changing.

# --- Matching thresholds (cosine similarity, 0-1) ---
# Start conservative and tune against your own labeled data; these
# defaults favor catching more candidates for human review over
# silently missing clones.
FACE_MATCH_THRESHOLD=0.62
VOICE_MATCH_THRESHOLD=0.75

# --- Scheduler ---
SCAN_INTERVAL_MINUTES=30

# --- YouTube Data API v3 (optional) ---
# Free key from https://console.cloud.google.com/apis/credentials
# Required only if you register a "youtube" scan source.
YOUTUBE_API_KEY=

# --- Alerts (optional) ---
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
