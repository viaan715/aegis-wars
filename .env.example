# Required for live address -> aerial image -> AI phasing plan
OPENAI_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Uses a legacy-compatible satellite style supported by Mapbox Static Images API.
MAPBOX_STYLE=mapbox/satellite-v9
OPENAI_VISION_MODEL=gpt-5.5

# Set to true only after confirming that your imagery license allows this use:
# creating a contractor/guest-facing annotated plan from imagery and sending the image
# to your AI processor. For commercial deployments, obtain the right imagery license.
IMAGERY_LICENSE_CONFIRMED=false

# Where saved plans (opt-in "Save to history") are stored: a small SQLite database
# plus one PNG per saved plan. Nothing is saved unless a user clicks "Save to history".
# In production, point this at a persistent volume/disk, or history will be lost on redeploy.
DATA_DIR=./data

# Basic abuse protection on /api/generate-plan (it calls paid OpenAI + Mapbox APIs).
# Max requests per client IP within the rolling window below.
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=300

LOG_LEVEL=INFO

# Optional
APP_ENV=development
