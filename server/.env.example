PORT=4000
# Required — a Postgres connection string, e.g. postgres://user:pass@host:5432/dbname
# Free hosted options: Render, Supabase, Neon all offer a free Postgres instance.
DATABASE_URL=
# Optional — auto-generated and persisted to server/data/jwt.secret if unset
JWT_SECRET=
# Required for AI form generation / question improvement — without it, those
# features return a friendly "not configured" error but the rest of the app
# still works fine.
ANTHROPIC_API_KEY=
# Required for the file_upload question type — without these, the rest of the
# app still works fine, but submitting a file answer returns a friendly
# "not configured" error. Works with any S3-compatible provider: Cloudflare R2
# (recommended — free tier, no egress fees), AWS S3, Backblaze B2, Supabase
# Storage, etc.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The base URL files are publicly reachable at, e.g. https://pub-xxxx.r2.dev
# (no trailing slash) — this is how uploaded file URLs get built.
S3_PUBLIC_URL_BASE=
# Optional — only needed for S3-compatible providers other than AWS itself
# (e.g. Cloudflare R2's account-specific endpoint). Leave blank for real AWS S3.
S3_ENDPOINT=
# Optional — defaults to 'auto', which works for R2. Set to a real AWS region
# (e.g. us-east-1) when using AWS S3.
S3_REGION=
