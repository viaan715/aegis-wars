PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Random long string used to sign JWT session tokens. Required.
JWT_SECRET=change-this-to-a-long-random-string

# Where the SQLite database file is stored.
DB_PATH=./data/app.db

# Optional: enables "Sign in with Google". Create an OAuth 2.0 Client ID
# (Web application) in Google Cloud Console and put its client ID here.
GOOGLE_CLIENT_ID=

# Optional: enables the "Send to Instacart" button. Get an API key from the
# Instacart Developer Platform (https://docs.instacart.com/developer_platform_api).
INSTACART_API_KEY=
# "development" uses https://connect.dev.instacart.tools, "production" uses
# https://connect.instacart.com
INSTACART_ENV=development
