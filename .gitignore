__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Runtime data — biometric references, downloaded media, and the DB
# must never be committed. See app/config.py for paths.
data/uploads/*
!data/uploads/.gitkeep
data/incoming/*
!data/incoming/.gitkeep
data/media/*
!data/media/.gitkeep
data/evidence/*
!data/evidence/.gitkeep
*.db
*.sqlite3

.env
.DS_Store
*.log
.pytest_cache/
.mypy_cache/
